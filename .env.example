# required for real generation. if missing, FLATPACK runs in MOCK mode (placeholder panels) so you can test the app plumbing
GEMINI_API_KEY=
# swap models here and nowhere else
IMAGE_MODEL=gemini-2.5-flash-image
VISION_MODEL=gemini-2.5-flash
# optional
PORT=3000
IMAGE_ASPECT=1:1
CALL_TIMEOUT_MS=60000
GUIDES_PER_HOUR=20
# force mock mode even with a key: FLATPACK_MOCK=1
