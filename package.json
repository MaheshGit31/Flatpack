    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "idb": "^8.0.4",
    "onnxruntime-web": "^1.31.0-dev.20260914-8d85527a0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "^7.0.0"
